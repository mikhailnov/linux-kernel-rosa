#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/thermal/thermal.h>

#define CA75_CLUSTER(chip, group, a,b,c,d)				\
	cluster##group {						\
		core0 {							\
			cpu = <&cpu##a>;				\
		};							\
		core1 {							\
			cpu = <&cpu##b>;				\
		};							\
		core2 {							\
			cpu = <&cpu##c>;				\
		};							\
		core3 {							\
			cpu = <&cpu##d>;				\
		};							\
		soc##chip##_l3_##group: l3-cache {			\
			compatible = "cache";				\
			cache-size = <0x200000>;			\
			cache-line-size = <64>;				\
			cache-sets = <2048>;				\
			cache-unified;					\
			cache-level = <3>;				\
			next-level-cache = <&soc##chip##_l4>;		\
		};							\
		cpu_opp_table##chip##group: opp_table {			\
			compatible = "operating-points-v2";		\
			opp-shared;					\
			opp-1800000000 {				\
				opp-hz = /bits/ 64 <1800000000>;	\
			};						\
			opp-1900000000 {				\
				opp-hz = /bits/ 64 <1900000000>;	\
			};						\
			opp-2000000000 {				\
				opp-hz = /bits/ 64 <2000000000>;	\
			};						\
		};							\
	}

#define CA75_CPU(chip, group, core, affinity)					\
	cpu##core: cpu@##chip##000##affinity {					\
		device_type = "cpu";						\
		compatible = "arm,cortex-a75";					\
		reg = <0x##chip 0x##affinity>;					\
		enable-method = "psci";						\
		i-cache-size = <0x10000>;					\
		i-cache-line-size = <64>;					\
		i-cache-sets = <256>;						\
		d-cache-size = <0x10000>;					\
		d-cache-line-size = <64>;					\
		d-cache-sets = <64>;						\
		next-level-cache = <&l2_##core>;				\
		operating-points-v2 = <&cpu_opp_table##chip##group>;		\
		clocks = <&soc##chip##_ca75_##group##_cmu1_pll>;		\
		numa-node-id = <chip>;						\
		#cooling-cells = <2>; /* min followed by max */			\
		l2_##core: l2-cache {						\
			compatible = "cache";					\
			cache-size = <0x80000>;					\
			cache-line-size = <64>;					\
			cache-sets = <1024>;					\
			cache-unified;						\
			cache-level = <2>;					\
			next-level-cache = <&soc##chip##_l3_##group>;		\
		};								\
	}

#define CLK_TYPE_REFCLK	1 /* fout = 25 MHz or 100 MHz		*/
#define CLK_TYPE_PLL	2 /* fout = 2 * fref * NF / (NR * OD)	*/
#define CLK_TYPE_CLKCH	3 /* fout = fref / (VAL_CLKDIV + 1)	*/
#define CLK_TYPE_CLKEN	4 /* fout = fref / DIV_VAL		*/
#define CLK_TYPE_CLKDIV	5 /* fout = fref / 2^(DIV_VAL - 1)	*/

#define STRINGIFY2( x) #x
#define STRINGIFY(x) STRINGIFY2(x)

#define CA75_CLOCKS(chip, group, hbase, lbase)						\
	/* pll */									\
	soc##chip##_ca75_##group##_cmu0_pll:						\
	soc##chip##_ca75_##group##_cmu0_pll {						\
		compatible = "baikal,bs1000-cmu";					\
		reg = <0x##hbase 0x##lbase>;						\
		type = <CLK_TYPE_PLL>;							\
		clocks = <&soc##chip##_clk_ref>;					\
		#clock-cells = <0>;							\
		clock-output-names = "ca75_pll0";					\
	};										\
	soc##chip##_ca75_##group##_cmu1_pll:						\
	soc##chip##_ca75_##group##_cmu1_pll {						\
		compatible = "baikal,bs1000-cmu";					\
		reg = <0x##hbase (0x##lbase + 0x10000)>;				\
		type = <CLK_TYPE_PLL>;							\
		clocks = <&soc##chip##_clk_ref>;					\
		#clock-cells = <0>;							\
		clock-output-names = "ca75_pll1";					\
		clock-frequency = <2000000000>;						\
	};										\
	/* clkch */									\
	soc##chip##_ca75_##group##_cmu0_clkch:						\
	soc##chip##_ca75_##group##_cmu0_clkch {						\
		compatible = "baikal,bs1000-cmu";					\
		reg = <0x##hbase (0x##lbase + 0x100)>;					\
		type = <CLK_TYPE_CLKCH>;						\
		clocks = <&soc##chip##_ca75_##group##_cmu0_pll>;			\
		#clock-cells = <1>;							\
		clock-output-names =							\
			"sclk",		/* 0 */						\
			"periph",	/* 1 */						\
			"pclk",		/* 2 */						\
			"at",		/* 3 */						\
			"gic",		/* 4 */						\
			"cfg_int",	/* 5 */						\
			"cfg_out",	/* 6 */						\
			"bisr",		/* 7 */						\
			"crp";		/* 8 */						\
	};										\
	/* clken */									\
	soc##chip##_ca75_##group##_cmu0_en0:						\
	soc##chip##_ca75_##group##_cmu0_en0 {						\
		compatible = "baikal,bs1000-cmu";					\
		reg = <0x##hbase (0x##lbase + 0x500)>;					\
		type = <CLK_TYPE_CLKEN>;						\
		clocks = <&soc##chip##_ca75_##group##_cmu0_clkch 0>; /* "sclk" */	\
		#clock-cells = <0>;							\
		clock-output-names = "clken";						\
	};										\
	soc##chip##_ca75_##group##_cmu0_en1:						\
	soc##chip##_ca75_##group##_cmu0_en1 {						\
		compatible = "baikal,bs1000-cmu";					\
		reg = <0x##hbase (0x##lbase + 0x510)>;					\
		type = <CLK_TYPE_CLKEN>;						\
		clocks = <&soc##chip##_ca75_##group##_cmu0_clkch 1>; /* "periph" */	\
		#clock-cells = <1>;							\
		clock-output-names =							\
			"cntclken",	/* 0 */						\
			"tsclken";	/* 1 */						\
	};										\
	/* core */									\
	soc##chip##_ca75_##group##_cmu1_core:						\
	soc##chip##_ca75_##group##_cmu1_core {						\
		compatible = "baikal,bs1000-cmu";					\
		reg = <0x##hbase (0x##lbase + 0x10020)>;				\
		type = <CLK_TYPE_CLKDIV>;						\
		clocks = <&soc##chip##_ca75_##group##_cmu1_pll>;			\
		#clock-cells = <1>;							\
		clock-output-names =							\
			"core0",	/* 0 */						\
			"core1",	/* 1 */						\
			"core2",	/* 2 */						\
			"core3";	/* 3 */						\
		clock-frequency =							\
			<2000000000>,							\
			<2000000000>,							\
			<2000000000>,							\
			<2000000000>;							\
	}

#define MM_CLOCKS(chip, mm, num, hbase, lbase, ...)			\
	/* pll */							\
	soc##chip##_##mm##_cmu##num##_pll:				\
	soc##chip##_##mm##_cmu##num##_pll {				\
		compatible = "baikal,bs1000-cmu";			\
		reg = <0x##hbase 0x##lbase>;				\
		type = <CLK_TYPE_PLL>;					\
		clocks = <&soc##chip##_clk_ref>;			\
		#clock-cells = <0>;					\
		clock-output-names = STRINGIFY(mm ## pll); 		\
	};								\
	/* clkch */							\
	soc##chip##_##mm##_cmu##num##_clkch:				\
	soc##chip##_##mm##_cmu##num##_clkch {				\
		compatible = "baikal,bs1000-cmu";			\
		reg = <0x##hbase (0x##lbase + 0x20)>;			\
		type = <CLK_TYPE_CLKCH>;				\
		clocks = <&soc##chip##_##mm##_cmu##num##_pll>;		\
		#clock-cells = <1>;					\
		clock-output-names = __VA_ARGS__;			\
	}

#define CLOCKS(chip, hbase)							\
	/* CLK_REF */								\
	soc##chip##_clk_ref: soc##chip##_clk_ref {				\
		compatible = "baikal,bs1000-cmu";				\
		reg = <0x##hbase 0xdead>;					\
		type = <CLK_TYPE_REFCLK>;					\
		#clock-cells = <0>;						\
		clock-output-names = "clk_ref";					\
	};									\
										\
	CA75_CLOCKS(chip, 0, hbase, 04000000);					\
	CA75_CLOCKS(chip, 1, hbase, 08000000);					\
	CA75_CLOCKS(chip, 2, hbase, 0c000000);					\
	CA75_CLOCKS(chip, 3, hbase, 10000000);					\
	CA75_CLOCKS(chip, 4, hbase, 14000000);					\
	CA75_CLOCKS(chip, 5, hbase, 18000000);					\
	CA75_CLOCKS(chip, 6, hbase, 1c000000);					\
	CA75_CLOCKS(chip, 7, hbase, 20000000);					\
	CA75_CLOCKS(chip, 8, hbase, 24000000);					\
	CA75_CLOCKS(chip, 9, hbase, 28000000);					\
	CA75_CLOCKS(chip, 10,hbase, 2c000000);					\
	CA75_CLOCKS(chip, 11,hbase, 30000000);					\
										\
	/* PCIe */								\
	MM_CLOCKS(chip, pci_0,, hbase, 38000000,				\
		"nic_cfg0m_ssa_x16p0s",		/* 0  */			\
		"nic_cfg1m_ssa_x8p1s",		/* 1  */			\
		"nic_cfg2m_mmu_tcus",		/* 2  */			\
		"nic_cfg3m_ssa_apbs",		/* 3  */			\
		"nic_cfg4m_nic_slv_gpvs",	/* 4  */			\
		"nic_slv0m_ssa_x16p0s",		/* 5  */			\
		"nic_slv1m_ssa_x8p1s",		/* 6  */			\
		"ssa_x16p0m_nic_mstr0s",	/* 7  */			\
		"ssa_x8p1m_nic_mstr1s",		/* 8  */			\
		"nic_mstrm_mmu_tbu0s",		/* 9  */			\
		"a4sw_intern",			/* 10 */			\
		"phy_ref",			/* 11 */			\
		"ssa_aux",			/* 12 */			\
		"ahb2axim_axi2ahbs",		/* 13 */			\
		"ahb2ahbm_outp_ahbs",		/* 14 */			\
		"ssa_x16p0m_cxlas"		/* 15 */			\
	);									\
	MM_CLOCKS(chip, pci_1,, hbase, 3c000000,				\
		"nic_cfg0m_ssa_x16p0s",		/* 0  */			\
		"nic_cfg1m_ssa_x8p1s",		/* 1  */			\
		"nic_cfg2m_mmu_tcus",		/* 2  */			\
		"nic_cfg3m_ssa_apbs",		/* 3  */			\
		"nic_cfg4m_nic_slv_gpvs",	/* 4  */			\
		"nic_slv0m_ssa_x16p0s",		/* 5  */			\
		"nic_slv1m_ssa_x8p1s",		/* 6  */			\
		"ssa_x16p0m_nic_mstr0s",	/* 7  */			\
		"ssa_x8p1m_nic_mstr1s",		/* 8  */			\
		"nic_mstrm_mmu_tbu0s",		/* 9  */			\
		"a4sw_intern",			/* 10 */			\
		"phy_ref",			/* 11 */			\
		"ssa_aux",			/* 12 */			\
		"ahb2axim_axi2ahbs",		/* 13 */			\
		"ahb2ahbm_outp_ahbs",		/* 14 */			\
		"ssa_x16p0m_cxlas"		/* 15 */			\
	);									\
	MM_CLOCKS(chip, pci_2,, hbase, 44000000,				\
		"a", /* 0 */							\
		"b"  /* 1 */							\
	);									\
	MM_CLOCKS(chip, pci_3,, hbase, 48000000,				\
		"a", /* 0 */							\
		"b"  /* 1 */							\
	);									\
	MM_CLOCKS(chip, pci_4,, hbase, 4c000000,				\
		"a", /* 0 */							\
		"b"  /* 1 */							\
	);									\
										\
	/* DDR */								\
	MM_CLOCKS(chip, ddr_0,, hbase, 50000000,				\
		"ddr_ctrl_phy",		/* 0 */					\
		"ddr_axi_slv",		/* 1 */					\
		"ddr_apb_slv"		/* 2 */					\
	);									\
	MM_CLOCKS(chip, ddr_1,, hbase, 54000000,				\
		"ddr_ctrl_phy",		/* 0 */					\
		"ddr_axi_slv",		/* 1 */					\
		"ddr_apb_slv",		/* 2 */					\
		"axi_ext_cfg",		/* 3 */					\
		"axi_middle_cfg",	/* 4 */					\
		"axi_top_cfg",		/* 5 */					\
		"axi_bottom_cfg"	/* 6 */					\
	);									\
	MM_CLOCKS(chip, ddr_2,, hbase, 58000000,				\
		"ddr_ctrl_phy",		/* 0 */					\
		"ddr_axi_slv",		/* 1 */					\
		"ddr_apb_slv"		/* 2 */					\
	);									\
	MM_CLOCKS(chip, ddr_3,, hbase, 60000000,				\
		"ddr_ctrl_phy",		/* 0 */					\
		"ddr_axi_slv",		/* 1 */					\
		"ddr_apb_slv"		/* 2 */					\
	);									\
	MM_CLOCKS(chip, ddr_4,, hbase, 64000000,				\
		"ddr_ctrl_phy",		/* 0 */					\
		"ddr_axi_slv",		/* 1 */					\
		"ddr_apb_slv",		/* 2 */					\
		"axi_ext_cfg",		/* 3 */					\
		"axi_middle_cfg",	/* 4 */					\
		"axi_top_cfg",		/* 5 */					\
		"axi_bottom_cfg"	/* 6 */					\
	);									\
	MM_CLOCKS(chip, ddr_5,, hbase, 68000000,				\
		"ddr_ctrl_phy",		/* 0 */					\
		"ddr_axi_slv",		/* 1 */					\
		"ddr_apb_slv"		/* 2 */					\
	);									\
										\
	/* System Control */							\
	MM_CLOCKS(chip, sc, 0, hbase, 00400000,					\
		"cmn",			/* 0 */					\
		"cmn_cs"		/* 1 */					\
	);									\
	MM_CLOCKS(chip, sc, 1, hbase, 00410000,					\
		"apb_cfg",		/* 0  */				\
		"scp_efuse",		/* 1  */				\
		"scp_ext_cfg",		/* 2  */				\
		"scp_apb_spi",		/* 3  */				\
		"scp_uart",		/* 4  */				\
		"scp_gpio8_x16",	/* 5, additional divisor by 16 */	\
		"scp_spi",		/* 6  */				\
		"scp_smbus_i2c0",	/* 7  */				\
		"scp_smbus_i2c1",	/* 8  */				\
		"gmac1_apb",		/* 9  */				\
		"gmac1_axi",		/* 10 */				\
		"gmac2_apb",		/* 11 */				\
		"gmac2_axi",		/* 12 */				\
		"usb_h",		/* 13 */				\
		"usb_ohci",		/* 14 */				\
		"lsp_apb",		/* 15 */				\
		"lsp_gpio_x16",		/* 16, additional divisor by 16 */	\
		"lsp_uart",		/* 17 */				\
		"lsp_uart_arm1",	/* 18 */				\
		"lsp_uart_arm2",	/* 19 */				\
		"lsp_spi1",		/* 20 */				\
		"lsp_spi2",		/* 21 */				\
		"lsp_espi",		/* 22 */				\
		"lsp_smbus_i2c2",	/* 23 */				\
		"lsp_smbus_i2c3",	/* 24 */				\
		"lsp_smbus_i2c4",	/* 25 */				\
		"lsp_smbus_i2c5",	/* 26 */				\
		"lsp_smbus_i2c6",	/* 27 */				\
		"lsp_timer1",		/* 28 */				\
		"lsp_timer2",		/* 29 */				\
		"lsp_timer3",		/* 30 */				\
		"lsp_timer4",		/* 31 */				\
		"lsp_wdt_x16",		/* 32, additional divisor by 16 */	\
		"tcu",			/* 33 */				\
		"sc_axi_cfg",		/* 34 */				\
		"ca75_ahb_cfg"		/* 35 */				\
	);									\
	MM_CLOCKS(chip, sc, 2, hbase, 00420000,					\
		"scp",			/* 0  */				\
		"gmac1_ptp",		/* 1  */				\
		"gmac1_txx2",		/* 2  */				\
		"gmac2_ptp",		/* 3  */				\
		"gmac2_txx2",		/* 4  */				\
		"gic_distr",		/* 5  */				\
		"dbg",			/* 6  */				\
		"cnt_valueb",		/* 7  */				\
		"ts_valueb",		/* 8  */				\
		"lpd",			/* 9  */				\
		"tbu",			/* 10 */				\
		"hs_cfg",		/* 11 */				\
		"scp_bisr"		/* 12 */				\
	)

#define SOC(chip, hbase, spi_base)									\
	soc##chip##_mailbox_sms: mailbox@##hbase##00210000 {						\
		compatible = "baikal,baikal-mbox-sms";							\
		reg = <0x##hbase 0x210000 0x0 0x10000>;							\
		interrupts = <GIC_SPI (spi_base + 33) IRQ_TYPE_LEVEL_HIGH>;				\
		#mbox-cells = <1>;									\
		status = "disabled";									\
	};												\
													\
	sram@##hbase##0001fd00 {									\
		compatible = "mmio-sram";								\
		reg = <0x##hbase 0x1fd00 0x0 0x100>;							\
													\
		#address-cells = <1>;									\
		#size-cells = <1>;									\
		ranges = <0 0x##hbase 0x1fd00 0x100>;							\
													\
		soc##chip##_shmem_scmi_a2p: scmi-shmem@0 {						\
			compatible = "arm,scmi-shmem";							\
			reg = <0x0 0x80>;								\
		};											\
													\
		soc##chip##_shmem_scmi_p2a: scmi-shmem@80 {						\
			compatible = "arm,scmi-shmem";							\
			reg = <0x80 0x80>;								\
		};											\
	};												\
													\
	soc##chip##_mailbox_scmi_a2p: mailbox@##hbase##00240000 {					\
		compatible = "baikal,baikal-mbox-scmi";							\
		reg = <0x##hbase 0x240000 0x0 0x10000>;							\
		interrupts = <GIC_SPI (spi_base + 36) IRQ_TYPE_LEVEL_HIGH>;				\
		#mbox-cells = <1>;									\
		status = "disabled";									\
	};												\
													\
	soc##chip##_mailbox_scmi_p2a: mailbox@##hbase##00250000 {					\
		compatible = "baikal,baikal-mbox-scmi";							\
		reg = <0x##hbase 0x250000 0x0 0x10000>;							\
		interrupts = <GIC_SPI (spi_base + 37) IRQ_TYPE_LEVEL_HIGH>;				\
		#mbox-cells = <1>;									\
		status = "disabled";									\
	};												\
													\
	scmi##chip {											\
		compatible = "baikal,scmi", "arm,scmi";							\
		mboxes = <&soc##chip##_mailbox_scmi_a2p 0 &soc##chip##_mailbox_scmi_p2a 0>;		\
		mbox-names = "tx", "rx";								\
		shmem = <&soc##chip##_shmem_scmi_a2p &soc##chip##_shmem_scmi_p2a>;			\
		arm,max-rx-timeout-ms = <300>;								\
		#address-cells = <1>;									\
		#size-cells = <0>;									\
		numa-node-id = <chip>;									\
													\
		soc##chip##_scmi_base_ext: protocol@80 {						\
			reg = <0x80>;									\
			sms = <&soc##chip##_mailbox_sms 2>;						\
			#thermal-sensor-cells = <1>;							\
		};											\
	};												\
													\
	soc##chip##_sc_smmu: iommu@##hbase##00900000 {							\
		compatible = "arm,smmu-v3";								\
		reg = <0x##hbase 0x900000 0x0 0x60000>;							\
		interrupts = <GIC_SPI (spi_base + 41) IRQ_TYPE_EDGE_RISING>,				\
			     <GIC_SPI (spi_base + 42) IRQ_TYPE_EDGE_RISING>,				\
			     <GIC_SPI (spi_base + 44) IRQ_TYPE_EDGE_RISING>,				\
			     <GIC_SPI (spi_base + 46) IRQ_TYPE_EDGE_RISING>;				\
		interrupt-names = "eventq", "priq", "cmdq-sync", "gerror";				\
		#iommu-cells = <1>;									\
		baikal,bs1000-bypass-gic;								\
		status = "disabled";									\
	};												\
													\
	soc##chip##_ohci: usb@##hbase##00a00000 {							\
		compatible = "generic-ohci";								\
		reg = <0x##hbase 0xa00000 0x0 0x1000>;							\
		interrupts = <GIC_SPI (spi_base + 78) IRQ_TYPE_LEVEL_HIGH>;				\
		dr_mode = "host";									\
		clocks = <&soc##chip##_sc_cmu1_clkch 13>,						\
			 <&soc##chip##_sc_cmu1_clkch 14>;						\
		clock-names = "ohci_hclk", "ohci_clk48";						\
		iommus = <&soc##chip##_sc_smmu 0x2>;							\
		status = "disabled";									\
	};												\
													\
	soc##chip##_ehci: usb@##hbase##00a10000 {							\
		compatible = "generic-ehci";								\
		reg = <0x##hbase 0xa10000 0x0 0x1000>;							\
		interrupts = <GIC_SPI (spi_base + 82) IRQ_TYPE_LEVEL_HIGH>;				\
		dr_mode = "host";									\
