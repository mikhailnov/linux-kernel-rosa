#define CA75_THERMAL(chip, group, pvt, a,b,c,d)							\
	thermal##chip##_cluster##group {							\
		polling-delay-passive = <1000>;							\
		polling-delay = <5000>;								\
		thermal-sensors = <&soc##chip##_scmi_base_ext pvt>;				\
												\
		trips {										\
			soc##chip##_cluster##group##_alert: cluster-alert {			\
				temperature = <75000>;						\
				hysteresis = <2000>;						\
				type = "passive";						\
			};									\
			crit {									\
				temperature = <85000>;						\
				hysteresis = <2000>;						\
				type = "critical";						\
			};									\
		};										\
												\
		cooling-maps {									\
			map0 {									\
				trip = <&soc##chip##_cluster##group##_alert>;			\
				cooling-device = <&cpu##a THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,	\
						 <&cpu##b THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,	\
						 <&cpu##c THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,	\
						 <&cpu##d THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;	\
			};									\
		};										\
	}

#define PVT_THERMAL(chip, pvt)						\
	thermal##chip##_pvt##pvt {					\
		polling-delay-passive = <1000>;				\
		polling-delay = <5000>;					\
		thermal-sensors = <&soc##chip##_scmi_base_ext pvt>;	\
									\
		trips {							\
			crit {						\
				temperature = <85000>;			\
				hysteresis = <2000>;			\
				type = "critical";			\
			};						\
		};							\
	}

/ {
	compatible = "baikal,bs1000";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;
	dma-coherent;

	aliases {
		i2c2	= &soc0_i2c2;
		i2c3	= &soc0_i2c3;
		i2c4	= &soc0_i2c4;
		i2c5	= &soc0_i2c5;
		i2c6	= &soc0_i2c6;
		serial0	= &soc0_uart_a1;
		serial1	= &soc0_uart_a2;
		serial2	= &soc0_uart_s;
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {
			socket0 {
				CA75_CLUSTER(0,0,0,1,2,3);
				CA75_CLUSTER(0,1,4,5,6,7);
				CA75_CLUSTER(0,2,8,9,10,11);
				CA75_CLUSTER(0,3,12,13,14,15);
				CA75_CLUSTER(0,4,16,17,18,19);
				CA75_CLUSTER(0,5,20,21,22,23);
				CA75_CLUSTER(0,6,24,25,26,27);
				CA75_CLUSTER(0,7,28,29,30,31);
				CA75_CLUSTER(0,8,32,33,34,35);
				CA75_CLUSTER(0,9,36,37,38,39);
				CA75_CLUSTER(0,10,40,41,42,43);
				CA75_CLUSTER(0,11,44,45,46,47);

				soc0_l4: l4-cache {
					cache-size = <0x2000000>;
					cache-unified;
					cache-level = <4>;
				};
			};
		};

		CA75_CPU(0,0,0,00000);
		CA75_CPU(0,0,1,00100);
		CA75_CPU(0,0,2,00200);
		CA75_CPU(0,0,3,00300);
		CA75_CPU(0,1,4,10000);
		CA75_CPU(0,1,5,10100);
		CA75_CPU(0,1,6,10200);
		CA75_CPU(0,1,7,10300);
		CA75_CPU(0,2,8,20000);
		CA75_CPU(0,2,9,20100);
		CA75_CPU(0,2,10,20200);
		CA75_CPU(0,2,11,20300);
		CA75_CPU(0,3,12,30000);
		CA75_CPU(0,3,13,30100);
		CA75_CPU(0,3,14,30200);
		CA75_CPU(0,3,15,30300);
		CA75_CPU(0,4,16,40000);
		CA75_CPU(0,4,17,40100);
		CA75_CPU(0,4,18,40200);
		CA75_CPU(0,4,19,40300);
		CA75_CPU(0,5,20,50000);
		CA75_CPU(0,5,21,50100);
		CA75_CPU(0,5,22,50200);
		CA75_CPU(0,5,23,50300);
		CA75_CPU(0,6,24,60000);
		CA75_CPU(0,6,25,60100);
		CA75_CPU(0,6,26,60200);
		CA75_CPU(0,6,27,60300);
		CA75_CPU(0,7,28,70000);
		CA75_CPU(0,7,29,70100);
		CA75_CPU(0,7,30,70200);
		CA75_CPU(0,7,31,70300);
		CA75_CPU(0,8,32,80000);
		CA75_CPU(0,8,33,80100);
		CA75_CPU(0,8,34,80200);
		CA75_CPU(0,8,35,80300);
		CA75_CPU(0,9,36,90000);
		CA75_CPU(0,9,37,90100);
		CA75_CPU(0,9,38,90200);
		CA75_CPU(0,9,39,90300);
		CA75_CPU(0,10,40,a0000);
		CA75_CPU(0,10,41,a0100);
		CA75_CPU(0,10,42,a0200);
