	pmu {
		compatible = "arm,cortex-a75-pmu", "arm,armv8-pmuv3";
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW>;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		SOC(0,0,0);

		clocks {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <0>;

			CLOCKS(0,0);

			refclk1mhz: refclk1mhz {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <1000000>;
				clock-output-names = "refclk1mhz";
			};
			refclk7372800hz: refclk7372800hz {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <7372800>;
				clock-output-names = "refclk7372800hz";
			};
			refclk8mhz: refclk8mhz {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <8000000>;
				clock-output-names = "refclk8mhz";
			};
			refclk50mhz: refclk50mhz {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <50000000>;
				clock-output-names = "refclk50mhz";
			};
			refclk200mhz: refclk200mhz {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <200000000>;
				clock-output-names = "refclk200mhz";
			};
		};

		gic: interrupt-controller@1000000 {
			compatible = "arm,gic-v3";
			reg = <0x0 0x1000000 0x0 0x10000>,  /* GICD */
			      <0x0 0x1240000 0x0 0x600000>; /* GICR */
			#interrupt-cells = <3>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			interrupt-controller;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;

			soc0_its0: msi-controller@1040000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1040000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its1: msi-controller@1060000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1060000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its2: msi-controller@1080000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1080000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its3: msi-controller@10a0000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x10a0000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its4: msi-controller@10c0000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x10c0000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its5: msi-controller@10e0000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x10e0000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its6: msi-controller@1100000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1100000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its7: msi-controller@1120000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1120000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its8: msi-controller@1140000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1140000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its9: msi-controller@1160000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1160000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its10: msi-controller@1180000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1180000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its11: msi-controller@11a0000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x11a0000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its12: msi-controller@11c0000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x11c0000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its13: msi-controller@11e0000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x11e0000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its14: msi-controller@1200000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1200000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
			soc0_its15: msi-controller@1220000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x1220000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
				numa-node-id = <0>;
			};
		};

		wdt: watchdog {
			compatible = "baikal,wdt";
			mbox-names = "wdt";
			mboxes = <&soc0_mailbox_sms 1>;
			status = "disabled";
		};
	};

	thermal-zones {
		CA75_THERMAL(0,0,1,0,1,2,3);
		CA75_THERMAL(0,1,2,4,5,6,7);
		CA75_THERMAL(0,2,3,8,9,10,11);
		CA75_THERMAL(0,3,4,12,13,14,15);
		CA75_THERMAL(0,4,5,16,17,18,19);
		CA75_THERMAL(0,5,6,20,21,22,23);
		CA75_THERMAL(0,6,7,24,25,26,27);
		CA75_THERMAL(0,7,8,28,29,30,31);
		CA75_THERMAL(0,8,9,32,33,34,35);
		CA75_THERMAL(0,9,10,36,37,38,39);
		CA75_THERMAL(0,10,11,40,41,42,43);
		CA75_THERMAL(0,11,12,44,45,46,47);
		PVT_THERMAL(0,0);
		PVT_THERMAL(0,13);
		PVT_THERMAL(0,14);
		PVT_THERMAL(0,15);
		PVT_THERMAL(0,16);
		PVT_THERMAL(0,17);
		PVT_THERMAL(0,18);
		PVT_THERMAL(0,19);
		PVT_THERMAL(0,20);
		PVT_THERMAL(0,21);
		PVT_THERMAL(0,22);
		PVT_THERMAL(0,23);
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
	};
};

