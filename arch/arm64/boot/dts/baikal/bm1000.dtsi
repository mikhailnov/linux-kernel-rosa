		mali_smmu: iommu@2a080000 {
			compatible = "arm,mmu-500";
			reg = <0x0 0x2a080000 0x0 0x40000>;
			#global-interrupts = <6>;
			interrupts = <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH>,
