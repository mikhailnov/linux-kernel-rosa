		pvt_cluster1: pvt@c200000 {
			compatible = "baikal,bm1000-pvt";
			reg = <0x0 0xc200000 0x0 0x1000>;
			interrupts = <GIC_SPI 121 IRQ_TYPE_LEVEL_HIGH>;
