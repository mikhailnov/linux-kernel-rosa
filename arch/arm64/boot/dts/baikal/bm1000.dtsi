		usb2: usb@2c400000 {
			compatible = "snps,dwc3";
			reg = <0x0 0x2c400000 0x0 0x100000>;
			interrupts = <GIC_SPI 235 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dwc_usb3";
			dr_mode = "host";
			dma-coherent;
			clocks = <&usb_cmu0 5>, <&usb_cmu0 6>;
			clock-names = "bus_early", "ref";
			phys = <&usb_phy 0>;
			phy-names = "usb2-phy";
			iommus = <&usb_smmu 0x200 0xf8>;
			status = "disabled";
		};

		usb3: usb@2c500000 {
			compatible = "snps,dwc3";
			reg = <0x0 0x2c500000 0x0 0x100000>;
			interrupts = <GIC_SPI 237 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dwc_usb3";
			dr_mode = "host";
			dma-coherent;
			clocks = <&usb_cmu0 11>, <&usb_cmu0 12>, <&usb_cmu0 13>;
			clock-names = "bus_early", "ref", "suspend";
			phys = <&usb_phy 1>, <&usb_phy 2>;
			phy-names = "usb3-phy", "usb2-phy";
			iommus = <&usb_smmu 0x201 0xf8>;
			status = "disabled";
		};

		usb_phy: usb_phy {
			compatible = "baikal,bm1000-usb-phy";
			clocks = <&usb_cmu0 3>, <&usb_cmu0 4>, <&usb_cmu0 7>,
				 <&usb_cmu0 8>, <&usb_cmu0 9>, <&usb_cmu0 10>;
			#phy-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			usb-phy@0 {
				reg = <0>;
				enable;
			};
			usb-phy@1 {
				reg = <1>;
				enable;
			};
			usb-phy@2 {
				reg = <2>;
				enable;
			};
		};

		sata0: sata@2c600000 {
			compatible = "baikal,bm1000-ahci";
			reg = <0x0 0x2c600000 0 0x10000>;
			interrupts = <GIC_SPI 233 IRQ_TYPE_LEVEL_HIGH>;
			ports-implemented = <1>;
			dma-coherent;
			clocks = <&refclk400mhz>;
			clock-names = "aclk";
			iommus = <&usb_smmu 0x202 0xf8>;
			status = "disabled";
		};

		sata1: sata@2c610000 {
			compatible = "baikal,bm1000-ahci";
			reg = <0x0 0x2c610000 0 0x10000>;
			interrupts = <GIC_SPI 234 IRQ_TYPE_LEVEL_HIGH>;
			ports-implemented = <1>;
			dma-coherent;
			clocks = <&refclk400mhz>;
			clock-names = "aclk";
			iommus = <&usb_smmu 0x203 0xf8>;
			status = "disabled";
		};

		dmac_m2m: dma-controller@2c630000 {
			compatible = "arm,pl330", "arm,primecell";
			reg = <0x0 0x2c630000 0 0x10000>;
			#dma-cells = <1>;
			#dma-channels = <8>;
			#dma-requests = <32>;
			interrupts = <GIC_SPI 223 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 224 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 225 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 226 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 227 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 228 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 229 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 230 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 231 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&refclk400mhz>;
			clock-names = "apb_pclk";
			status = "disabled";
		};

		gic: interrupt-controller@2d000000 {
			compatible = "arm,gic-v3";
			reg = <0x0 0x2d000000 0x0 0x10000>,  /* GICD */
			      <0x0 0x2d100000 0x0 0x200000>, /* GICR */
			      <0x0 0x10200000 0x0 0x2000>,   /* GICC */
			      <0x0 0x10210000 0x0 0x1000>,   /* GICH */
			      <0x0 0x10220000 0x0 0x2000>;   /* GICV */
			#interrupt-cells = <3>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			interrupt-controller;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;

			its: msi-controller@2d020000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x2d020000 0x0 0x20000>;
				msi-controller;
				#msi-cells = <1>;
			};
		};

		xgbe_smmu: iommu@30080000 {
			compatible = "arm,mmu-500";
			reg = <0x0 0x30080000 0x0 0x40000>;
			#global-interrupts = <5>;
			interrupts = <GIC_SPI 333 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 334 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 368 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 369 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 335 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 336 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 337 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 338 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 339 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 340 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 341 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 342 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 343 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 344 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 345 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 346 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 347 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 348 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 349 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 350 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 351 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 352 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 353 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 354 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 355 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 356 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 357 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 358 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 359 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 360 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 361 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 362 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 363 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 364 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 365 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 366 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 367 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <2>;
			dma-coherent;
			status = "disabled";
		};

		xgmac0: ethernet@30200000 {
			compatible = "baikal,bm1000-xgmac";
			reg = <0x0 0x30200000 0x0 0x10000>;
			reg-names = "stmmaceth";
			dma-coherent;

			interrupts = <GIC_SPI 293 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 295 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 298 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 299 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 301 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 303 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 304 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 305 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 306 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 307 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 308 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 309 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq",
					  "dma_tx0", "dma_tx1", "dma_tx2", "dma_tx3",
					  "dma_tx4", "dma_tx5", "dma_tx6", "dma_tx7",
					  "dma_rx0", "dma_rx1", "dma_rx2", "dma_rx3",
					  "dma_rx4", "dma_rx5", "dma_rx6", "dma_rx7";
			clocks = <&xgbe_cmu0 1>, <&xgbe_cmu0 3>, <&xgbe_cmu0 2>, <&xgbe_cmu0 4>;
			clock-names = "pclk", "stmmaceth", "tx", "ptp_ref";

			pcs-handle = <&xgmac0_pcs>;

			/*
			 * xgmii - auto-negotiate 10GBASE-KX4/KR protocols
			 *         (set the managed property to "in-band-status")
			 * 10gbase-r - select 10GBASE-R protocol
			 * 10gbase-x/xaui - select 10GBASE-X protocol
			 *         (set the managed property to "auto")
			 */
			phy-mode = "xgmii";
			managed = "in-band-status";

			rx-fifo-depth = <131072>;
			tx-fifo-depth = <131072>;

			/*
			 * Actual burst length will be (32 * 8 * 16) bytes due
			 * to the snps,no-pbl-x8 property absence and having
			 * the AXI bus data width of 128 bits.
			 */
			snps,pbl = <32>;
			snps,data-width = <16>;

			/* Enable TSO for all DMA channels */
			snps,tso;

			snps,perfect-filter-entries = <8>;
			snps,multicast-filter-bins = <64>;

			snps,mtl-rx-config = <&xgmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&xgmac_mtl_tx_setup>;

			snps,axi-config = <&xgmac0_axi_setup>;

			max-frame-size = <12180>;

			status = "disabled";

			xgmac0_axi_setup: stmmac-axi-config {
				snps,wr_osr_lmt = <0x1f>;
				snps,rd_osr_lmt = <0x1f>;
				/* It's AXI3 bus so up to 16 xfers */
				snps,blen = <0 0 0 0 16 8 4>;
			};
		};

		xgmac0_pcs: ethernet-pcs@30210000 {
			compatible = "baikal,bm1000-xpcs";
			reg = <0 0x30210000 0 0x10000>;
			reg-names = "indirect";
			reg-io-width = <4>;
			interrupts = <GIC_SPI 327 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xgbe_cmu0 1>, <&xgbe_cmu0 2>, <&refclk156250khz>;
			clock-names = "csr", "core", "pad";
			status = "disabled";
		};

		xgmac1: ethernet@30220000 {
			compatible = "baikal,bm1000-xgmac";
			reg = <0x0 0x30220000 0x0 0x10000>;
			reg-names = "stmmaceth";
			dma-coherent;

			interrupts = <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 312 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 313 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 314 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 315 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 317 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 318 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 319 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 320 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 321 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 322 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 323 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 324 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 325 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 326 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq",
					  "dma_tx0", "dma_tx1", "dma_tx2", "dma_tx3",
					  "dma_tx4", "dma_tx5", "dma_tx6", "dma_tx7",
					  "dma_rx0", "dma_rx1", "dma_rx2", "dma_rx3",
					  "dma_rx4", "dma_rx5", "dma_rx6", "dma_rx7";
			clocks = <&xgbe_cmu0 1>, <&xgbe_cmu0 6>, <&xgbe_cmu0 5>, <&xgbe_cmu0 7>;
			clock-names = "pclk", "stmmaceth", "tx", "ptp_ref";

			pcs-handle = <&xgmac1_pcs>;

			/*
			 * xgmii - auto-negotiate 10GBASE-KX4/KR protocols
			 *         (set the managed property to "in-band-status")
			 * 10gbase-r - select 10GBASE-R protocol
			 * 10gbase-x/xaui - select 10GBASE-X protocol
			 *         (set the managed property to "auto")
			 */
			phy-mode = "xgmii";
			managed = "in-band-status";

			rx-fifo-depth = <131072>;
			tx-fifo-depth = <131072>;

			/*
			 * Actual burst length will be (32 * 8 * 16) bytes due
			 * to the snps,no-pbl-x8 property absence and having
			 * the AXI bus data width of 128 bits.
			 */
			snps,pbl = <32>;
			snps,data-width = <16>;

			/* Enable TSO for all DMA channels */
			snps,tso;

			snps,perfect-filter-entries = <8>;
			snps,multicast-filter-bins = <64>;

			snps,mtl-rx-config = <&xgmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&xgmac_mtl_tx_setup>;

			snps,axi-config = <&xgmac1_axi_setup>;

			max-frame-size = <12180>;

			status = "disabled";

			xgmac1_axi_setup: stmmac-axi-config {
				snps,wr_osr_lmt = <0x1f>;
				snps,rd_osr_lmt = <0x1f>;
				/* It's AXI3 bus so up to 16 xfers */
				snps,blen = <0 0 0 0 16 8 4>;
			};
		};

		xgmac1_pcs: ethernet-pcs@30230000 {
			compatible = "baikal,bm1000-xpcs";
			reg = <0 0x30230000 0 0x10000>;
			reg-names = "indirect";
			reg-io-width = <4>;
			interrupts = <GIC_SPI 328 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xgbe_cmu0 1>, <&xgbe_cmu0 5>, <&refclk156250khz>;
			clock-names = "csr", "core", "pad";
			status = "disabled";
		};

		stmmac_axi_setup: stmmac-axi-config {
			snps,wr_osr_lmt = <0x0>;
			snps,rd_osr_lmt = <0x0>;
			snps,blen = <0 0 0 0 0 0 4>;
		};

		xgmac_mtl_rx_setup: xgmac-rx-queues-config {
			snps,rx-queues-to-use = <8>;
			snps,rx-sched-sp;

			queue0 {
				snps,dcb-algorithm;
				snps,priority = <0x1>;
			};
			queue1 {
				snps,dcb-algorithm;
				snps,priority = <0x2>;
			};
			queue2 {
				snps,dcb-algorithm;
				snps,priority = <0x4>;
			};
			queue3 {
				snps,dcb-algorithm;
				snps,priority = <0x8>;
			};
			queue4 {
				snps,dcb-algorithm;
				snps,priority = <0x10>;
			};
			queue5 {
				snps,dcb-algorithm;
				snps,priority = <0x20>;
			};
			queue6 {
				snps,dcb-algorithm;
				snps,priority = <0x40>;
			};
			queue7 {
				snps,dcb-algorithm;
				snps,priority = <0x80>;
			};
		};

		xgmac_mtl_tx_setup: xgmac-tx-queues-config {
			snps,tx-queues-to-use = <8>;
			snps,tx-sched-sp;

			queue0 {
				snps,dcb-algorithm;
				snps,priority = <0x1>;
			};
			queue1 {
				snps,dcb-algorithm;
				snps,priority = <0x2>;
			};
			queue2 {
				snps,dcb-algorithm;
				snps,priority = <0x4>;
			};
			queue3 {
				snps,dcb-algorithm;
				snps,priority = <0x8>;
			};
			queue4 {
				snps,dcb-algorithm;
				snps,priority = <0x10>;
			};
			queue5 {
				snps,dcb-algorithm;
				snps,priority = <0x20>;
			};
			queue6 {
				snps,dcb-algorithm;
				snps,priority = <0x40>;
			};
			queue7 {
				snps,dcb-algorithm;
				snps,priority = <0x80>;
			};
		};

		gmac0: ethernet@30240000 {
			compatible = "baikal,bm1000-gmac";
			reg = <0x0 0x30240000 0x0 0x10000>;
			interrupts = <GIC_SPI 291 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq";
			max-speed = <1000>;
			clocks = <&refclk50mhz>, <&xgbe_cmu0 10>;
			clock-names = "stmmaceth", "tx2_clk";
			snps,axi-config = <&stmmac_axi_setup>;
			snps,fixed-burst;
			snps,no-pbl-x8;
			snps,txpbl = <4>;
			snps,rxpbl = <4>;
			dma-coherent;
			status = "disabled";

			mdio0: mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};

		gmac1: ethernet@30250000 {
			compatible = "baikal,bm1000-gmac";
			reg = <0x0 0x30250000 0x0 0x10000>;
			interrupts = <GIC_SPI 292 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq";
			max-speed = <1000>;
			clocks = <&refclk50mhz>, <&xgbe_cmu0 13>;
			clock-names = "stmmaceth", "tx2_clk";
			snps,axi-config = <&stmmac_axi_setup>;
			snps,fixed-burst;
			snps,no-pbl-x8;
			snps,txpbl = <4>;
			snps,rxpbl = <4>;
			dma-coherent;
			status = "disabled";

			mdio1: mdio {
