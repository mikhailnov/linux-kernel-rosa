/dts-v1/;

#include "bs1000.dtsi"

/ {
	model = "Baikal Electronics QEMU-S";
	compatible = "baikal,qemu-s", "baikal,bs1000";

	aliases {
		ethernet0 = &soc0_gmac0;
		ethernet1 = &soc0_gmac1;
	};

	chosen { };

	/*
	 * Device is necessary for UEFI to boot on QEMU,
	 * need to replace it with something later.
	 */
	flash@0 {
		compatible = "cfi-flash";
		reg = <0x0 0x4000000 0x0 0x4000000>;
		bank-width = <0x4>;
	};
};

&soc0_ehci {
	status = "okay";
};

&soc0_gmac0 {
	status = "okay";
	phy-handle = <&ethphy0>;
	phy-mode = "rgmii-rxid";
};

&soc0_gmac1 {
	status = "okay";
	phy-handle = <&ethphy1>;
	phy-mode = "rgmii-rxid";
};

&soc0_mdio0 {
	reset-delay-us = <10200>;
	reset-post-delay-us = <1000>;

	ethphy0: ethernet-phy@3 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x3>;
	};
};

&soc0_mdio1 {
	reset-delay-us = <10200>;
	reset-post-delay-us = <1000>;

	ethphy1: ethernet-phy@3 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x3>;
	};
};

&soc0_ohci {
	status = "okay";
};

&soc0_qspi1 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <12500000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL1";
				reg = <0x000000 0x20000>;
			};

			partition@20000 {
				label = "DDR-FW";
				reg = <0x020000 0x20000>;
			};

			partition@40000 {
				label = "FIP";
				reg = <0x40000 0x200000>;
			};

			partition@240000 {
				label = "DDR-CFG0";
				reg = <0x240000 0x40000>;
			};

			partition@280000 {
				label = "DDR-CFG1";
				reg = <0x280000 0x40000>;
			};

			partition@2c0000 {
				label = "UEFI vars";
				reg = <0x2c0000 0xc0000>;
			};

			partition@380000 {
				label = "FAT";
				reg = <0x380000 0x1c80000>;
			};
		};
	};
};

&soc0_timer1 {
	status = "okay";
};

&soc0_uart_a1 {
	status = "okay";
};

&soc0_uart_a2 {
	status = "okay";
};

&soc0_uart_s {
	status = "okay";
};
